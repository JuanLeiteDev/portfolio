{
  "name": "juanleite-portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Portfólio de Juan Leite — Software Engineering & Intelligent Automation",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "serve": "node scripts/serve.mjs 4321",
    "assets": "node scripts/generate-assets.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "audit:lh": "node scripts/lighthouse.mjs",
    "audit:bundle": "node scripts/bundle-report.mjs",
    "verify": "npm run check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@lucide/astro": "1.77.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
