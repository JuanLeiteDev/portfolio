---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Projects from '@/components/sections/Projects.astro';
import Approach from '@/components/sections/Approach.astro';
import Skills from '@/components/sections/Skills.astro';
import Journey from '@/components/sections/Journey.astro';
import Contact from '@/components/sections/Contact.astro';
import { routes, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const meta = {
  pt: {
    title: 'Juan Leite — Software, automação e IA aplicada',
    description:
      'Juan Leite, estudante de Engenharia de Sistemas Informáticos na UPCA. Ferramentas em Python, automação de processos, backend e diagnóstico de incidentes.',
  },
  en: {
    title: 'Juan Leite — Software, automation and applied AI',
    description:
      'Juan Leite, Computer Systems Engineering student at UPCA. Python tools, process automation, backend work and incident diagnosis.',
  },
}[lang];
---

<Base lang={lang} title={meta.title} description={meta.description} paths={routes.home} onHome>
  <Hero lang={lang} />
  <Projects lang={lang} />
  <Journey lang={lang} />
  <Skills lang={lang} />
  <Approach lang={lang} />
  <Contact lang={lang} />
</Base>
