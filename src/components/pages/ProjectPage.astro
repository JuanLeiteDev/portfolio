---
/**
 * Case study page. One model for every project: context → my role →
 * solution → technical decisions → result, with stack, status and verified
 * links in the facts sidebar. Blocks without confirmed content are absent.
 */
import { ArrowLeft, ArrowUpRight, Play } from '@lucide/astro';
import { Picture, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { projects, kindLabel, caseOrder, caseHeadings, type Project } from '@/data/projects';
import { profile } from '@/data/profile';
import { routes, sectionHref, ui, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];
const paths = routes.project(p.slug);
const name = t(p.name, lang);
// characters in the name's longest word: the title shrinks so that word fits
// on one line (a name like "XI.Analyzer" is never cut in the middle)
const fit = Math.max(...name.split(/\s+/).map((w) => w.length));
// presentation video: optimised posters (the PNGs from the render are ~1 MB)
const v = p.video;
const poster = v ? await getImage({ src: v.poster, format: 'webp', width: 1600, quality: 80 }) : null;
const posterMobile = v ? await getImage({ src: v.posterMobile, format: 'webp', width: 800, quality: 80 }) : null;
const title = `${name} — ${lang === 'pt' ? 'Estudo de caso' : 'Case study'} · ${profile.name}`;
const description = t(p.description, lang);
const blocks = caseOrder.flatMap((key) => {
  const b = p.study[key];
  return b ? [{ key, heading: t(caseHeadings[key], lang), ...b }] : [];
});

// the rail (desktop) and the dock (mobile) index this page's own sections:
// an overview (title + screenshots) and then each numbered block
const overview = { pt: 'Visão geral', en: 'Overview' };
const nav = [
  { key: 'overview', n: '00', label: t(overview, lang), href: '#case-overview' },
  ...blocks.map((s, i) => ({ key: s.key, n: String(i + 1).padStart(2, '0'), label: s.heading, href: `#b-${s.key}` })),
];

const labels = {
  stack: { pt: 'Tecnologias', en: 'Technologies' },
  status: { pt: 'Estado', en: 'Status' },
  year: { pt: 'Ano', en: 'Year' },
  type: { pt: 'Tipo', en: 'Type' },
  context: { pt: 'Contexto', en: 'Context' },
  links: { pt: 'Ligações', en: 'Links' },
  platform: { pt: 'Plataforma', en: 'Platform' },
};

const jsonLd = [
  {
    '@type': 'CreativeWork',
    name,
    description,
    dateCreated: p.year,
    inLanguage: lang === 'pt' ? 'pt-PT' : 'en',
    author: { '@id': profile.personId },
    keywords: p.stack.join(', '),
    ...(p.links[0] ? { url: p.links[0].href } : {}),
  },
];
---

<Base
  lang={lang}
  title={title}
  description={description}
  paths={paths}
  ogType="article"
  jsonLd={jsonLd}
  nav={nav}
  navLabel={lang === 'pt' ? 'Nesta página' : 'On this page'}
>
  <article class="case frame" aria-labelledby="case-title">
    <nav class="crumbs mono" aria-label={lang === 'pt' ? 'Navegação estrutural' : 'Breadcrumb'}>
      <a class="back" href={sectionHref('projects', lang, false)}>
        <ArrowLeft size={16} stroke-width={1.6} aria-hidden="true" />
        {t(ui.back, lang)}
      </a>
      <span class="pos num" aria-hidden="true">
        {String(idx + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
      </span>
    </nav>

    <div
      id="case-overview"
      class="overview"
      data-section="overview"
      data-index="00"
      data-label={t(overview, lang)}
      data-alt-id="case-overview"
    >
    <header class="head">
      <p class="kind mono">
        <span aria-hidden="true">[</span>{t(kindLabel[p.kind], lang)}<span aria-hidden="true">]</span>
        <span class="sep" aria-hidden="true">·</span>
        {t(p.context, lang)}
      </p>
      <h1 id="case-title" class="title" tabindex="-1" style={`--fit:${fit}`}>{name}</h1>
      <p class="lede">{t(p.lede, lang)}</p>
    </header>

    {
      (p.media || v) && (
        <div class="gallery">
          {v && poster && posterMobile && (
            <figure class="shot wide clip" data-reveal data-clip data-poster-mobile={posterMobile.src}>
              <div class="shot-bar mono" aria-hidden="true">
                <span>{p.slug}</span>
                <span>{lang === 'pt' ? 'vídeo' : 'video'} · {v.length}</span>
              </div>
              <div class="clip-frame">
                <video
                  class="clip-video"
                  controls
                  playsinline
                  preload="none"
                  poster={poster.src}
                  aria-label={t(v.caption, lang)}
                >
                  <source media="(max-width: 47.999rem)" src={`${v.base}-4x5.mp4`} type="video/mp4" />
                  <source src={`${v.base}-16x9.mp4`} type="video/mp4" />
                  <track kind="captions" src={`${v.base}.pt.vtt`} srclang="pt-BR" label="Português" />
                </video>
                <button type="button" class="clip-play" data-clip-play hidden>
                  <span class="clip-icon" aria-hidden="true">
                    <Play size={22} stroke-width={1.8} fill="currentColor" />
                  </span>
                  <span class="clip-label">
                    {lang === 'pt' ? 'Ver vídeo' : 'Play video'}
                    <span class="clip-meta mono num">{v.length} · {lang === 'pt' ? 'com som' : 'with sound'}</span>
                  </span>
                </button>
              </div>
              <figcaption class="mono">{t(v.caption, lang)}</figcaption>
            </figure>
          )}
          {p.media?.map((m, i) => (
        <figure class:list={['shot', { wide: i === 0 || (i === p.media!.length - 1 && i % 2 === 1) }]} data-reveal style={`--i:${i}`}>
          <div class="shot-bar mono" aria-hidden="true">
            <span>{p.slug}</span>
            <span>{t(p.platform, lang).toLowerCase()}</span>
          </div>
          <Picture
            src={m.src}
            alt={t(m.alt, lang)}
            widths={[640, 960, 1280, 1600]}
            sizes={i === 0 ? '(min-width: 64rem) calc(100vw - 20rem), 100vw' : '(min-width: 64rem) calc(50vw - 10rem), 100vw'}
            formats={['avif']}
            fallbackFormat="webp"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="shot-img"
          />
          <figcaption class="mono">{t(m.caption, lang)}</figcaption>
        </figure>
          ))}
        </div>
      )
    }
    </div>

    <div class="body">
      <aside class="facts" aria-label={lang === 'pt' ? 'Ficha do projeto' : 'Project facts'}>
        <dl>
          <div>
            <dt class="label">{t(labels.year, lang)}</dt>
            <dd class="num">{p.year}</dd>
          </div>
          <div>
            <dt class="label">{t(labels.type, lang)}</dt>
            <dd>{t(kindLabel[p.kind], lang)}</dd>
          </div>
          <div>
            <dt class="label">{t(labels.platform, lang)}</dt>
            <dd>{t(p.platform, lang)}</dd>
          </div>
          <div>
            <dt class="label">{t(labels.status, lang)}</dt>
            <dd>{t(p.status, lang)}</dd>
          </div>
          <div>
            <dt class="label">{t(labels.stack, lang)}</dt>
            <dd>
              <ul class="stack mono" role="list">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
          {
            p.links.length > 0 && (
              <div>
                <dt class="label">{t(labels.links, lang)}</dt>
                <dd>
                  <ul class="links" role="list">
                    {p.links.map((l) => (
                      <li>
                        <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">
                          {t(l.label, lang)}
                          <ArrowUpRight class="ext" size={14} stroke-width={1.8} aria-hidden="true" />
                          <span class="sr-only"> {t(ui.newTab, lang)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        {
          blocks.map((s, i) => (
            <section
              class="block"
              aria-labelledby={`b-${s.key}`}
              data-reveal
              data-section={s.key}
              data-index={String(i + 1).padStart(2, '0')}
              data-label={s.heading}
              data-alt-id={`b-${s.key}`}
            >
              <h2 id={`b-${s.key}`} class="bh">
                <span class="bn mono num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {s.heading}
              </h2>
              {s.body?.[lang].map((para) => <p>{para}</p>)}
              {s.points && (
                <ul class="points" role="list">
                  {s.points[lang].map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </div>

    {
      next && next.slug !== p.slug && (
        <a class="next spot" href={routes.project(next.slug)[lang]}>
          <span class="label">{t(ui.nextProject, lang)}</span>
          <span class="nn">
            {t(next.name, lang)}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </span>
          <span class="ns">{t(next.summary, lang)}</span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .case {
    padding-top: clamp(1.5rem, 1rem + 3vw, 4rem);
  }
  .crumbs {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 2rem + 4vw, 5rem);
    color: var(--c-fg-subtle);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--c-fg-muted);
    transition: color var(--dur-1) linear;
  }
  .back:hover {
    color: var(--c-signal);
  }
  .overview {
    scroll-margin-top: 2rem;
  }
  .head {
    display: grid;
    gap: 1.25rem;
    max-width: 62rem;
    container-type: inline-size; /* the title sizes itself to this width */
  }
  .kind {
    color: var(--c-signal);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sep {
    color: var(--c-fg-subtle);
  }
  .kind :not(.sep) {
    color: inherit;
  }
  .title {
    /* the display size, but never wider than the header can hold for the
       longest word (≈ 0.64em per character in this weight and tracking) */
    font-size: min(var(--step-display), 100cqi / (var(--fit, 8) * 0.64));
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    /* last resort only, for screens far narrower than any phone */
    overflow-wrap: anywhere;
    outline: none;
  }
  .lede {
    max-width: 44ch;
    font-size: var(--step-2);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.012em;
  }

  .gallery {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem) 1.25rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shot.wide {
      grid-column: 1 / -1;
    }
  }
  .shot {
    min-width: 0;
  }
  .shot-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--c-line-strong);
    border-bottom: 0;
    border-radius: var(--radius-l) var(--radius-l) 0 0;
    background: var(--c-bg-raised);
    color: var(--c-fg-subtle);
    font-size: 0.72rem;
  }
  .shot-bar span:first-child::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-inline-end: 0.6rem;
    background: var(--c-signal);
  }
  .shot :global(.shot-img),
  .shot :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-line-strong);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
  }
  /* presentation video: same window frame as the screenshots; 16:9 on
     desktop, 4:5 below 48rem (the files follow the same breakpoint) */
  .clip-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--c-line-strong);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    background: #000;
  }
  .clip-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (max-width: 47.999rem) {
    .clip-video {
      aspect-ratio: 4 / 5;
    }
  }
  .clip-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    width: 100%;
    border: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.1) 55%);
    color: #fff;
    cursor: pointer;
  }
  .clip-play[hidden] {
    display: none;
  }
  .clip-icon {
    display: grid;
    place-items: center;
    width: clamp(3.75rem, 3rem + 3vw, 5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-signal);
    color: var(--c-signal-ink);
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.6);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .clip-icon :global(svg) {
    translate: 2px 0; /* optical centre of the triangle */
  }
  .clip-label {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    font-weight: 600;
    font-size: var(--step-1);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
  }
  .clip-meta {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.85;
  }
  .clip-play:hover .clip-icon,
  .clip-play:focus-visible .clip-icon {
    transform: scale(1.08);
  }
  .clip-play:focus-visible {
    outline: 2px solid var(--c-signal);
    outline-offset: -4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip-icon {
      transition: none;
    }
  }
  .shot figcaption {
    margin-top: 0.75rem;
    color: var(--c-fg-subtle);
    font-size: 0.75rem;
  }

  .body {
    display: grid;
    gap: 3rem;
    margin-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--c-line-strong);
  }
  @media (min-width: 64rem) {
    .body {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 5rem;
    }
    .facts {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
  /* the "on this page" index lives in the rail (desktop) and the dock (mobile) */
  .facts dl {
    display: grid;
    gap: 1.1rem;
  }
  @media (min-width: 36rem) and (max-width: 63.999rem) {
    .facts dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .facts dd {
    margin-top: 0.25rem;
    color: var(--c-fg-muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .stack li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-s);
    font-size: 0.76rem;
    color: var(--c-fg);
  }
  .links {
    display: grid;
    gap: 0.4rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--c-fg);
    min-height: 2rem;
  }

  .prose {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    max-width: 44rem;
  }
  .block {
    scroll-margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  .bh {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-size: var(--step-2);
  }
  .bn {
    color: var(--c-signal);
    font-size: var(--step--1);
    font-weight: 400;
  }
  .block p {
    color: var(--c-fg-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .points {
    display: grid;
    gap: 0.75rem;
  }
  .points li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.75rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-fg-muted);
  }
  .points li::before {
    content: '→';
    position: absolute;
    inset-inline-start: 0;
    font-family: var(--font-mono);
    color: var(--c-signal);
  }

  .next {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--section-gap);
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    transition: border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .nn {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .arrow {
    display: inline-block;
    margin-inline-start: 0.4em;
    font-family: var(--font-mono);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .ns {
    color: var(--c-fg-muted);
    max-width: 60ch;
  }
  .next:hover,
  .next:focus-visible {
    border-color: var(--c-signal);
    background: var(--c-bg-raised);
  }
  .next:hover .arrow,
  .next:focus-visible .arrow {
    transform: translateX(6px);
    color: var(--c-signal);
  }
</style>
