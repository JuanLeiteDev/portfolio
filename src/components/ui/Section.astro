---
/**
 * Section wrapper + indexed header ("§02 / projetos").
 * Data attributes feed the rail/dock tracker and the language-switch hash.
 */
import { sectionIds, sectionLabels, sectionOrder, otherLang, t, type Lang, type SectionKey } from '@/i18n';

interface Props {
  lang: Lang;
  section: SectionKey;
  title?: string;
  intro?: string;
  /** Extra ids kept for old-site anchors (e.g. #skills). */
  aliases?: string[];
  class?: string;
  headClass?: string;
}
const { lang, section, title, intro, aliases = [], class: className = '', headClass = '' } = Astro.props;
const index = String(sectionOrder.indexOf(section)).padStart(2, '0');
const id = sectionIds[section][lang];
const label = t(sectionLabels[section], lang);
const headingId = `${id}-title`;
---

<section
  id={id}
  class:list={['section', className]}
  data-section={section}
  data-index={index}
  data-label={label}
  data-alt-id={sectionIds[section][otherLang(lang)]}
  aria-labelledby={title ? headingId : undefined}
>
  {aliases.map((a) => <span id={a} class="alias" aria-hidden="true" />)}
  {
    title && (
      <header class:list={['section-head frame', headClass]} data-reveal>
        <span class="ghost-n num" aria-hidden="true">
          {index}
        </span>
        <div class="meta" aria-hidden="true">
          <span class="idx mono num" data-scramble>
            §{index} / {label.toLowerCase()}
          </span>
          <span class="ruler" />
        </div>
        <h2 id={headingId} class="title" tabindex="-1">
          {title}
        </h2>
        {intro && <p class="intro">{intro}</p>}
      </header>
    )
  }
  <slot />
</section>

<style>
  .section {
    position: relative;
    padding-top: var(--section-gap);
  }
  .alias {
    position: absolute;
    top: 0;
  }
  .section-head {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.25rem, 1.5rem + 3vw, 4rem);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .idx {
    flex: none;
    color: var(--c-signal);
  }
  .meta .ruler {
    flex: 1;
    transform-origin: left;
  }
  /* the ruler draws itself when the section enters (reveal-on-scroll) */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .section-head:not(.is-in) .ruler {
      transform: scaleX(0);
    }
    .meta .ruler {
      transition: transform 1.1s var(--ease-out) 0.15s;
    }
  }
  /* monumental outlined index behind the title */
  .ghost-n {
    position: absolute;
    z-index: -1;
    inset-inline-end: var(--gutter);
    bottom: -0.04em;
    font-size: clamp(5rem, 2rem + 9vw, 11.5rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-line-strong);
    user-select: none;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .section-head:not(.is-in) .ghost-n {
      opacity: 0;
      transform: translateY(0.08em);
    }
    .ghost-n {
      transition: opacity 1.2s var(--ease-out), transform 1.2s var(--ease-out);
    }
  }
  .title {
    max-width: 22ch;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    outline: none;
  }
  .intro {
    max-width: 58ch;
    color: var(--c-fg-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
