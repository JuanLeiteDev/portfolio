---
/**
 * Approach — the method as a scroll stack (after React Bits "Scroll Stack").
 *
 * Four cards (need → planning → solution → delivery) stick one over
 * the other as the page scrolls: plain `position: sticky`, so the page
 * scrolls natively (no scroll-jacking, no smooth-scroll library) and the
 * stack works without JS. scroll-stack.ts adds depth (cards underneath
 * shrink and dim) and marks the step in view. If a card would not fit the
 * viewport (short phones, landscape) the cards fall back to a normal list.
 *
 * Beside each step: one blueprint that evolves card by card (rev. A → D,
 * blueprint-scene.ts). It is drawn here at build time, at each card's own
 * stage, so it shows without JS; blueprint.ts then morphs it in from the
 * previous step, tilts it under the mouse and switches 3D ⇄ plan on a click.
 *
 * Below: the AI practice as four keywords, each explained on intent.
 */
import Section from '@/components/ui/Section.astro';
import Hint from '@/components/ui/Hint.astro';
import IntentTitle from '@/components/ui/IntentTitle.astro';
import { approach } from '@/data/home';
import { t, type Lang } from '@/i18n';
import { drawBlueprint, ISO, VB, type BpLabels } from '@/scripts/blueprint-scene';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const steps = approach.steps;
const total = String(steps.length).padStart(2, '0');
const bp = approach.blueprint;
const labels: BpLabels = {
  context: t(bp.labels.context, lang),
  problem: t(bp.labels.problem, lang),
  plan: t(bp.labels.plan, lang),
  solution: t(bp.labels.solution, lang),
};
const viewBox = `${VB.x} ${VB.y} ${VB.w} ${VB.h}`;
// without JS: each card's blueprint at its own stage
const still = (stage: number) => drawBlueprint(stage, { ...ISO, time: 0.3, u: 0.6 }, labels);
---

<Section lang={lang} section="approach" title={t(approach.title, lang)} intro={t(approach.intro, lang)}>
  <div class="frame">
    <ol class="stack" role="list" data-stack>
      {
        steps.map((s, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <li class:list={['card', `step-${s.id}`]} style={`--i:${i}`} data-stack-card>
              <article class="card-in" aria-labelledby={`step-${s.id}`}>
                <div class="side">
                  <header class="head mono num" aria-hidden="true">
                    <span class="n">{n}</span>
                    <span class="segs">
                      {steps.map((_, j) => (
                        <span class:list={['seg', { done: j < i, now: j === i }]} />
                      ))}
                    </span>
                    <span class="of">
                      {n}/{total}
                    </span>
                  </header>
                  <h3 id={`step-${s.id}`} class="ct">
                    <span class="sr-only">{n}. </span>
                    {t(s.title, lang)}
                  </h3>
                  <p class="body">{t(s.body, lang)}</p>
                  <p class="tag mono">
                    <span aria-hidden="true">$ </span>
                    {t(s.tag, lang)}
                  </p>
                </div>

                <div
                  class="bp"
                  data-bp
                  data-stage={i}
                  data-labels={JSON.stringify(labels)}
                  data-to-plan={t(bp.toPlan, lang)}
                  data-to3d={t(bp.to3d, lang)}
                >
                  <svg class="bp-svg" viewBox={viewBox} aria-hidden="true" focusable="false" set:html={still(i)} />
                  <div class="bp-foot mono">
                    <span aria-hidden="true">
                      {t(bp.name, lang)} · rev. <span class="rev" data-bp-rev>{'ABCD'[i]}</span>
                    </span>
                    {/* the view switch: only with JS (blueprint.ts shows it); a
                        click anywhere on the drawing does the same */}
                    <button type="button" class="bp-hint mono" data-bp-btn hidden>
                      <span class="ico" aria-hidden="true">⇄</span> <span class="sr-only">{t(bp.switchTo, lang)}</span><span data-bp-hint>{t(bp.toPlan, lang)}</span>
                    </button>
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <section class="ai" aria-labelledby="ai-title" data-reveal>
      <h3 id="ai-title" class="ai-title">{t(approach.ai.title, lang)}</h3>
      <ul class="practices" role="list">
        {
          approach.ai.practices.map((p, i) => (
            <li class="practice spot" data-intent>
              <span class="pk mono" aria-hidden="true">
                {String.fromCharCode(97 + i)}
              </span>
              <IntentTitle level={4} controls={`ai-${i}`} class="pt">
                {t(p.title, lang)}
              </IntentTitle>
              <Hint text={t(p.hint, lang)} id={`ai-${i}`} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Section>

<style>
  /* ------------------------------------------------------------ stack */
  .stack {
    --top: max(1rem, env(safe-area-inset-top));
    --peek: 0.65rem;
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(4rem, 3rem + 4vw, 7rem);
  }
  @media (min-width: 64rem) {
    .stack {
      --top: 2.5rem;
      --peek: 1.1rem;
      gap: 2.5rem;
    }
  }
  .card {
    position: sticky;
    top: calc(var(--top) + var(--i) * var(--peek));
  }
  .stack:global(.no-stick) .card {
    position: static;
  }
  @media (max-height: 30rem) {
    .card {
      position: static;
    }
  }
  .card-in {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.15rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    background-color: var(--c-bg-raised);
    box-shadow: 0 -18px 40px -28px rgb(0 0 0 / 0.6);
    transform-origin: 50% 0;
    transform: scale(calc(1 - min(var(--depth, 0), 3) * 0.04));
  }
  /* cards underneath dim as the next ones cover them */
  .card-in::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--c-bg);
    opacity: calc(min(var(--depth, 0), 2) * 0.28);
    pointer-events: none;
  }
  @media (min-width: 48rem) {
    .card-in {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      min-height: 21rem;
    }
  }

  .side {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--c-fg-subtle);
  }
  .n {
    color: var(--c-signal);
  }
  .segs {
    display: flex;
    flex: 1;
    max-width: 9rem;
    gap: 3px;
  }
  .seg {
    flex: 1;
    height: 3px;
    background: var(--c-line-strong);
  }
  .seg.done {
    background: var(--c-fg-subtle);
  }
  .seg.now {
    background: var(--c-signal);
  }
  .of {
    margin-inline-start: auto;
  }
  .ct {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .body {
    max-width: 34ch;
    line-height: 1.45;
  }
  @media (min-width: 48rem) {
    .ct {
      font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    }
    .body {
      font-size: var(--step-1);
      line-height: 1.4;
    }
  }
  /* phones: a denser card, so the stack still fits under the sticky offset */
  @media (max-width: 47.999rem) {
    .card-in {
      gap: 0.9rem;
    }
    .side {
      gap: 0.55rem;
    }
  }
  .tag {
    color: var(--c-fg-subtle);
  }
  @media (min-width: 48rem) {
    .tag {
      margin-top: auto;
    }
  }

  /* --------------------------------------------------------- blueprint */
  .bp {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.4rem;
    padding: clamp(0.6rem, 0.4rem + 1vw, 1.1rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    background-color: var(--c-bg);
    -webkit-tap-highlight-color: transparent;
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .bp:global(.is-live) {
    cursor: pointer;
  }
  .bp:global(.is-live):hover {
    border-color: var(--c-line-strong);
  }
  .bp-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    /* redrawn every frame while data flows: clicks land on the stable
       container instead (Firefox drops a click whose target was replaced
       between press and release) */
    pointer-events: none;
  }
  .bp-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--c-fg-subtle);
  }
  .rev {
    color: var(--c-signal);
  }
  /* the view switch (shown by blueprint.ts) */
  .bp-hint {
    margin: -0.35rem -0.5rem;
    padding: 0.35rem 0.5rem;
    border: 0;
    border-radius: var(--radius-s);
    background: none;
    color: inherit;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-out);
  }
  .bp-hint[hidden] {
    display: none;
  }
  .bp:hover .bp-hint,
  .bp-hint:focus-visible {
    color: var(--c-fg);
  }
  .bp-hint:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 1px;
  }
  .ico {
    display: inline-block;
    color: var(--c-signal);
  }

  /* the drawing (blueprint-scene.ts): colours only, so the theme switch
     needs no re-render */
  .bp-svg :global(line),
  .bp-svg :global(polygon),
  .bp-svg :global(circle),
  .bp-svg :global(path) {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp-svg :global(.bp-grid) {
    stroke: var(--c-line);
  }
  .bp-svg :global(.bp-edge) {
    stroke: var(--c-line-strong);
  }
  .bp-svg :global(.bp-plan) {
    fill: var(--c-signal-soft);
    fill-opacity: 0.5;
    stroke: var(--c-fg-muted);
  }
  .bp-svg :global(.bp-dim) {
    stroke: var(--c-fg-subtle);
  }
  .bp-svg :global(.bp-need) {
    stroke: var(--c-signal);
  }
  .bp-svg :global(.bp-link) {
    fill: none;
    stroke: var(--c-fg-muted);
  }
  /* the data's way over the modules */
  .bp-svg :global(.bp-track) {
    fill: none;
    stroke: var(--c-signal);
    stroke-opacity: 0.55;
  }
  .bp-svg :global(.bp-frame) {
    fill: none;
    stroke: var(--c-signal);
  }
  .bp-svg :global(.bp-face) {
    stroke: var(--c-fg-muted);
  }
  .bp-svg :global(.bp-face.top) {
    fill: color-mix(in srgb, var(--c-fg) 14%, var(--c-bg));
  }
  .bp-svg :global(.bp-face.l) {
    fill: color-mix(in srgb, var(--c-fg) 7%, var(--c-bg));
  }
  .bp-svg :global(.bp-face.r) {
    fill: color-mix(in srgb, var(--c-fg) 3%, var(--c-bg));
  }
  .bp-svg :global(.bp-item .bp-face) {
    stroke: var(--c-fg-subtle);
  }
  .bp-svg :global(.bp-item .bp-face.top) {
    fill: color-mix(in srgb, var(--c-fg) 30%, var(--c-bg));
  }
  .bp-svg :global(.is-lit .bp-face) {
    stroke: var(--c-signal);
  }
  .bp-svg :global(.is-lit .bp-face.top) {
    fill: color-mix(in srgb, var(--c-signal) 40%, var(--c-bg));
  }
  .bp-svg :global(.is-lit .bp-face.l) {
    fill: color-mix(in srgb, var(--c-signal) 20%, var(--c-bg));
  }
  .bp-svg :global(.is-lit .bp-face.r) {
    fill: color-mix(in srgb, var(--c-signal) 10%, var(--c-bg));
  }
  .bp-svg :global(.bp-dot) {
    fill: var(--c-signal);
  }
  .bp-svg :global(.bp-ok) {
    fill: var(--c-bg);
    stroke: var(--c-signal);
  }
  .bp-svg :global(.bp-ok path) {
    fill: none;
  }
  .bp-svg :global(text) {
    font-family: var(--font-mono);
    text-anchor: middle;
    letter-spacing: 0.02em;
    stroke: var(--c-bg);
    paint-order: stroke;
  }
  .bp-svg :global(.bp-lb) {
    fill: var(--c-fg-muted);
  }
  .bp-svg :global(.bp-q) {
    fill: var(--c-signal);
    font-weight: 600;
  }

  /* --------------------------------------------------------------- AI */
  .ai {
    display: grid;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .ai-title {
    font-size: var(--step-2);
  }
  .practices {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .practices {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .practice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .practice:is(:hover, :focus-within, .is-open) {
    border-color: var(--c-signal);
    background: var(--c-bg-raised);
  }
  .pk {
    color: var(--c-signal);
    padding-top: 0.2rem;
  }
  .practice :global(.pt) {
    font-size: var(--step-1);
  }
  .practice :global(.hint-wrap) {
    grid-column: 2;
  }
</style>
