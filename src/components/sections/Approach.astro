---
/**
 * Approach: the method condensed into the section intro (one line) and the
 * AI practice as four keywords, each explained on intent.
 */
import Section from '@/components/ui/Section.astro';
import Hint from '@/components/ui/Hint.astro';
import IntentTitle from '@/components/ui/IntentTitle.astro';
import { approach } from '@/data/home';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Section lang={lang} section="approach" title={t(approach.title, lang)} intro={t(approach.intro, lang)}>
  <div class="frame">
    <section class="ai" aria-labelledby="ai-title" data-reveal>
      <h3 id="ai-title" class="ai-title">{t(approach.ai.title, lang)}</h3>
      <ul class="practices" role="list">
        {
          approach.ai.practices.map((p, i) => (
            <li class="practice spot" data-intent>
              <span class="pk mono" aria-hidden="true">
                {String.fromCharCode(97 + i)}
              </span>
              <IntentTitle level={4} controls={`ai-${i}`} class="pt">
                {t(p.title, lang)}
              </IntentTitle>
              <Hint text={t(p.hint, lang)} id={`ai-${i}`} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Section>

<style>
  .ai {
    display: grid;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .ai-title {
    font-size: var(--step-2);
  }
  .practices {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .practices {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .practice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .practice:is(:hover, :focus-within, .is-open) {
    border-color: var(--c-signal);
    background: var(--c-bg-raised);
  }
  .pk {
    color: var(--c-signal);
    padding-top: 0.2rem;
  }
  .practice :global(.pt) {
    font-size: var(--step-1);
  }
  .practice :global(.hint-wrap) {
    grid-column: 2;
  }
</style>
