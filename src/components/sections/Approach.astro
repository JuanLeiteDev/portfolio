---
/**
 * Approach — the method as a scroll stack (after React Bits "Scroll Stack").
 *
 * Four cards (problem → diagnosis → implementation → testing) stick one over
 * the other as the page scrolls: plain `position: sticky`, so the page
 * scrolls natively (no scroll-jacking, no smooth-scroll library) and the
 * stack works without JS. scroll-stack.ts adds depth (cards underneath
 * shrink and dim) and marks the step in view, which plays its diagram once.
 * Each card pairs the general practice with what it was in a real project,
 * the log analyser. If a card would not fit the viewport (short phones,
 * landscape) the cards fall back to a normal list.
 *
 * Below: the AI practice as four keywords, each explained on intent.
 */
import Section from '@/components/ui/Section.astro';
import Hint from '@/components/ui/Hint.astro';
import IntentTitle from '@/components/ui/IntentTitle.astro';
import { approach } from '@/data/home';
import { routes, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const steps = approach.steps;
const total = String(steps.length).padStart(2, '0');
const list = (s: string) => s.split(',');
// schematic only: which cells/lines of the diagrams are highlighted
const hotFiles = new Set([5, 18, 21, 26, 37, 42]);
const logLines = [
  { w: 78, hot: false },
  { w: 54, hot: true },
  { w: 66, hot: false },
  { w: 48, hot: true },
  { w: 84, hot: false },
  { w: 52, hot: true },
  { w: 70, hot: false },
];
---

<Section lang={lang} section="approach" title={t(approach.title, lang)} intro={t(approach.intro, lang)}>
  <div class="frame">
    <ol class="stack" role="list" data-stack>
      {
        steps.map((s, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <li class:list={['card', `step-${s.id}`]} style={`--i:${i}`} data-stack-card>
              <article class="card-in" aria-labelledby={`step-${s.id}`}>
                <div class="side">
                  <header class="head mono num" aria-hidden="true">
                    <span class="n">{n}</span>
                    <span class="segs">
                      {steps.map((_, j) => (
                        <span class:list={['seg', { done: j < i, now: j === i }]} />
                      ))}
                    </span>
                    <span class="of">
                      {n}/{total}
                    </span>
                  </header>
                  <h3 id={`step-${s.id}`} class="ct">
                    <span class="sr-only">{n}. </span>
                    {t(s.title, lang)}
                  </h3>
                  <p class="body">{t(s.body, lang)}</p>
                  <p class="tag mono">
                    <span aria-hidden="true">$ </span>
                    {t(s.tag, lang)}
                  </p>
                </div>

                <div class="case">
                  <p class="case-label mono">{t(approach.caseLabel, lang)}</p>
                  <p class="case-text">{t(s.case, lang)}</p>

                  {s.id === 'problem' && (
                    <div class="viz viz-files" aria-hidden="true">
                      <span class="files">
                        {Array.from({ length: 48 }, (_, k) => (
                          <span class:list={['f', { hot: hotFiles.has(k) }]} style={`--k:${k}`} />
                        ))}
                      </span>
                      <span class="cap mono">{t(s.viz, lang)}</span>
                    </div>
                  )}
                  {s.id === 'diagnosis' && (
                    <div class="viz viz-lines" aria-hidden="true">
                      <span class="lines">
                        {logLines.map((l, k) => (
                          <span class:list={['ln', { hot: l.hot }]} style={`--w:${l.w}%;--k:${k}`} />
                        ))}
                        <span class="scan" />
                      </span>
                      <span class="cap mono">{t(s.viz, lang)}</span>
                    </div>
                  )}
                  {s.id === 'build' && (
                    <ol class="viz viz-pipe mono" aria-hidden="true">
                      {list(t(s.viz, lang)).map((label, k) => (
                        <li style={`--k:${k}`}>{label}</li>
                      ))}
                    </ol>
                  )}
                  {s.id === 'test' && (
                    <ul class="viz viz-checks mono" aria-hidden="true">
                      {list(t(s.viz, lang)).map((label, k) => (
                        <li style={`--k:${k}`}>
                          <span class="box" />
                          {label}
                        </li>
                      ))}
                    </ul>
                  )}

                  {i === steps.length - 1 && (
                    <a class="stack-link link mono" href={routes.project(approach.caseSlug)[lang]}>
                      {t(approach.caseLink, lang)}
                      <span aria-hidden="true"> →</span>
                    </a>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <section class="ai" aria-labelledby="ai-title" data-reveal>
      <h3 id="ai-title" class="ai-title">{t(approach.ai.title, lang)}</h3>
      <ul class="practices" role="list">
        {
          approach.ai.practices.map((p, i) => (
            <li class="practice spot" data-intent>
              <span class="pk mono" aria-hidden="true">
                {String.fromCharCode(97 + i)}
              </span>
              <IntentTitle level={4} controls={`ai-${i}`} class="pt">
                {t(p.title, lang)}
              </IntentTitle>
              <Hint text={t(p.hint, lang)} id={`ai-${i}`} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Section>

<style>
  /* ------------------------------------------------------------ stack */
  .stack {
    --top: max(1rem, env(safe-area-inset-top));
    --peek: 0.65rem;
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(4rem, 3rem + 4vw, 7rem);
  }
  @media (min-width: 64rem) {
    .stack {
      --top: 2.5rem;
      --peek: 1.1rem;
      gap: 2.5rem;
    }
  }
  .card {
    position: sticky;
    top: calc(var(--top) + var(--i) * var(--peek));
  }
  .stack:global(.no-stick) .card {
    position: static;
  }
  @media (max-height: 30rem) {
    .card {
      position: static;
    }
  }
  .card-in {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.15rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    background-color: var(--c-bg-raised);
    box-shadow: 0 -18px 40px -28px rgb(0 0 0 / 0.6);
    transform-origin: 50% 0;
    transform: scale(calc(1 - min(var(--depth, 0), 3) * 0.04));
  }
  /* cards underneath dim as the next ones cover them */
  .card-in::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--c-bg);
    opacity: calc(min(var(--depth, 0), 2) * 0.28);
    pointer-events: none;
  }
  @media (min-width: 48rem) {
    .card-in {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      min-height: 21rem;
    }
  }

  .side {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--c-fg-subtle);
  }
  .n {
    color: var(--c-signal);
  }
  .segs {
    display: flex;
    flex: 1;
    max-width: 9rem;
    gap: 3px;
  }
  .seg {
    flex: 1;
    height: 3px;
    background: var(--c-line-strong);
  }
  .seg.done {
    background: var(--c-fg-subtle);
  }
  .seg.now {
    background: var(--c-signal);
  }
  .of {
    margin-inline-start: auto;
  }
  .ct {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .body {
    max-width: 34ch;
    line-height: 1.45;
  }
  @media (min-width: 48rem) {
    .ct {
      font-size: var(--step-4);
    }
    .body {
      font-size: var(--step-1);
      line-height: 1.4;
    }
  }
  /* phones: a denser card, so the stack still fits under the sticky offset */
  @media (max-width: 47.999rem) {
    .card-in {
      gap: 0.9rem;
    }
    .side {
      gap: 0.55rem;
    }
    .case {
      gap: 0.55rem;
      padding: 0.85rem;
    }
    .case-text {
      font-size: 0.92rem;
      line-height: 1.5;
    }
  }
  .tag {
    color: var(--c-fg-subtle);
  }
  @media (min-width: 48rem) {
    .tag {
      margin-top: auto;
    }
  }

  .case {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    background: var(--c-bg);
  }
  .case-label {
    color: var(--c-signal);
  }
  .case-text {
    color: var(--c-fg-muted);
    max-width: 48ch;
  }
  .stack-link {
    justify-self: start;
    color: var(--c-fg);
  }

  /* ---------------------------------------------------------- diagrams */
  .viz {
    margin-top: 0.35rem;
  }
  .cap {
    display: block;
    margin-top: 0.6rem;
    color: var(--c-fg-subtle);
  }

  /* 01 — a wall of files, a few of them carrying the incident */
  .files {
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    gap: 3px;
  }
  .f {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--c-line-strong);
    border-radius: 1px;
    transition:
      opacity var(--dur-3) var(--ease-out),
      background-color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out);
    transition-delay: calc(var(--k) * 12ms);
  }
  .f.hot {
    border-color: var(--c-signal);
    background: var(--c-signal-soft);
  }

  /* 02 — log lines, the recurring ones picked out by a scan */
  .lines {
    position: relative;
    display: grid;
    gap: 7px;
    padding-block: 2px;
    overflow: hidden;
  }
  .ln {
    width: var(--w);
    height: 6px;
    border-radius: 1px;
    background: var(--c-line-strong);
    transition: background-color var(--dur-3) var(--ease-out);
    transition-delay: calc(200ms + var(--k) * 90ms);
  }
  .ln.hot {
    background: var(--c-signal);
  }
  .scan {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: var(--c-signal);
    box-shadow: 0 0 12px 2px var(--c-signal-soft);
    opacity: 0;
  }

  /* 03 — the pipeline lights up stage by stage */
  .viz-pipe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0;
  }
  .viz-pipe li {
    display: inline-flex;
    align-items: center;
  }
  .viz-pipe li:not(:last-child)::after {
    content: '→';
    padding-inline: 0.45rem;
    color: var(--c-fg-subtle);
  }
  .viz-pipe li {
    --c: var(--c-signal);
  }
  .viz-pipe li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline-end: 0.4rem;
    background: var(--c);
    transition: background-color var(--dur-3) var(--ease-out);
    transition-delay: calc(var(--k) * 220ms);
  }

  /* 04 — the import quality checks tick in */
  .viz-checks {
    display: grid;
    gap: 0.45rem;
    color: var(--c-fg-muted);
  }
  @media (min-width: 30rem) {
    .viz-checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }
  .viz-checks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .box {
    position: relative;
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    border: 1px solid var(--c-signal);
    border-radius: 2px;
  }
  .box::after {
    content: '';
    position: absolute;
    left: 31%;
    top: 12%;
    width: 30%;
    height: 55%;
    border: solid var(--c-signal);
    border-width: 0 2px 2px 0;
    rotate: 45deg;
    transition:
      opacity var(--dur-2) var(--ease-out),
      scale var(--dur-3) var(--ease-out);
    transition-delay: calc(150ms + var(--k) * 160ms);
  }

  /* initial states, only when scroll-stack.ts is running and motion is on:
     the diagram of a step plays once, when that step is in view */
  @media (prefers-reduced-motion: no-preference) {
    .stack:global(.is-ready) .card:not(:global(.is-seen)) .f {
      opacity: 0;
    }
    .stack:global(.is-ready) .card:not(:global(.is-seen)) .ln.hot {
      background: var(--c-line-strong);
    }
    .stack:global(.is-ready) .card:not(:global(.is-seen)) .viz-pipe li {
      --c: var(--c-line-strong);
    }
    .stack:global(.is-ready) .card:not(:global(.is-seen)) .box::after {
      opacity: 0;
      scale: 0.3;
    }
    .card:global(.is-seen) .scan {
      animation: scan-down 1.1s var(--ease-io) 0.1s both;
    }
  }
  @keyframes scan-down {
    0% {
      opacity: 0;
      top: 0;
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      top: 100%;
    }
  }

  /* --------------------------------------------------------------- AI */
  .ai {
    display: grid;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .ai-title {
    font-size: var(--step-2);
  }
  .practices {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .practices {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .practice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .practice:is(:hover, :focus-within, .is-open) {
    border-color: var(--c-signal);
    background: var(--c-bg-raised);
  }
  .pk {
    color: var(--c-signal);
    padding-top: 0.2rem;
  }
  .practice :global(.pt) {
    font-size: var(--step-1);
  }
  .practice :global(.hint-wrap) {
    grid-column: 2;
  }
</style>
