---
/**
 * Hero — identity, value proposition and the two primary paths
 * (projects / contact) in the first screen on every viewport.
 *
 * Desktop: monumental name + statement on the left, glyph portrait on the right.
 * Mobile: name stacks over two lines, CTAs stay above the fold, the portrait
 * becomes a wide "scan" band below them.
 */
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import Section from '@/components/ui/Section.astro';
import { hero } from '@/data/home';
import { profile } from '@/data/profile';
import { sectionHref, t, type Lang } from '@/i18n';
import photo from '@/assets/juan-leite.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Section lang={lang} section="about" class="hero" aliases={lang === 'pt' ? ['hero'] : []}>
  <div class="frame grid-hero">
    <div class="copy">
      <p class="eyebrow mono">
        <span class="dot" aria-hidden="true"></span>
        {t(hero.eyebrow, lang)}
      </p>

      <h1 class="name">
        <span class="sr-only">{profile.name}</span>
        <span class="name-vis" aria-hidden="true">
          <span class="line" data-decode>Juan</span>{' '}
          <span class="line"><span data-decode>Leite</span><span class="cursor"></span></span>
        </span>
      </h1>

      <p class="statement">{t(hero.statement, lang)}</p>
      <ul class="kw mono" role="list">
        {hero.keywords.map((k) => <li>{t(k, lang)}</li>)}
      </ul>

      <div class="ctas">
        <a class="btn btn-primary" href={sectionHref('projects', lang)}>
          {t(hero.ctaPrimary, lang)}
          <span class="arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn" href={sectionHref('contact', lang)}>
          {t(hero.ctaSecondary, lang)}
          <ArrowUpRight class="arrow" size={18} stroke-width={1.6} aria-hidden="true" />
        </a>
      </div>
    </div>

    <figure class="portrait-wrap">
      <div class="portrait" data-glyph-portrait>
        <Picture
          src={photo}
          alt={t(hero.photoAlt, lang)}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 60vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="photo"
        />
        <canvas aria-hidden="true"></canvas>
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
      </div>
      <figcaption class="caption mono" aria-hidden="true">
        <span>fig. 00 — {profile.name.toLowerCase().replace(' ', '_')}</span>
        <span class="num">41.53°N 8.62°W</span>
      </figcaption>
    </figure>

    <dl class="meta mono">
      {
        hero.meta.map((m) => (
          <div>
            <dt>{t(m.k, lang)}</dt>
            <dd>{t(m.v, lang)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  :global(.hero.section) {
    padding-top: clamp(1.5rem, 0.5rem + 4vw, 5rem);
    overflow-x: clip; /* the portrait glow must not create horizontal scroll */
  }
  .grid-hero {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'copy'
      'portrait'
      'meta';
  }
  .copy {
    grid-area: copy;
    min-width: 0;
  }
  .portrait-wrap {
    grid-area: portrait;
    position: relative;
  }
  .portrait-wrap::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -30% -25% -20%;
    background: radial-gradient(closest-side, var(--c-signal-soft), transparent);
    pointer-events: none;
  }
  .grid-hero {
    isolation: isolate;
  }
  .meta {
    grid-area: meta;
  }

  @media (min-width: 64rem) {
    .grid-hero {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.5fr);
      grid-template-areas:
        'copy portrait'
        'meta meta';
      column-gap: clamp(2rem, 4vw, 5rem);
      row-gap: 3.5rem;
      align-items: start;
    }
    .portrait-wrap {
      /* aligns the photo with the cap height of the name */
      margin-top: calc(var(--step--1) * 1.6 + clamp(1.25rem, 3vw, 2.25rem));
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-fg-muted);
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--c-signal);
  }

  .name {
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin-inline-start: -0.04em;
  }
  .name-vis {
    display: block;
  }
  .line {
    display: block;
  }
  @media (min-width: 30rem) {
    .line {
      display: inline;
    }
    .line + .line::before {
      content: ' ';
    }
  }
  @media (min-width: 64rem) {
    .line {
      display: block;
    }
    .line + .line::before {
      content: none;
    }
  }
  .cursor {
    display: inline-block;
    width: 0.09em;
    height: 0.1em;
    margin-inline-start: 0.06em;
    background: var(--c-signal);
    vertical-align: baseline;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) 4 both;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.dc-cell) {
    position: relative;
    display: inline-block;
  }
  :global(.dc-ghost) {
    visibility: hidden;
  }
  :global(.dc-live) {
    position: absolute;
    inset: 0;
    text-align: center;
    color: var(--c-signal);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.82em;
    line-height: 1.25;
  }
  :global(.dc-live.is-set) {
    color: inherit;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .statement {
    max-width: 22ch;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--step-3);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 500;
    text-wrap: balance;
  }
  .kw {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .kw li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-fg-muted);
    font-size: 0.8rem;
  }
  .kw li:first-child {
    border-color: var(--c-signal);
    color: var(--c-fg);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 29.999rem) {
    .ctas .btn {
      flex: 1 1 9rem;
      justify-content: space-between;
    }
  }

  /* portrait */
  .portrait {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--c-bg-sunken);
    isolation: isolate;
  }
  @media (min-width: 48rem) {
    .portrait {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 64rem) {
    .portrait {
      aspect-ratio: 4 / 5;
    }
  }
  .portrait :global(.photo),
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    filter: grayscale(1) contrast(1.05);
  }
  .portrait canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-signal);
    border-style: solid;
    pointer-events: none;
  }
  .tl {
    top: 10px;
    left: 10px;
    border-width: 1px 0 0 1px;
  }
  .br {
    right: 10px;
    bottom: 10px;
    border-width: 0 1px 1px 0;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    font-size: 0.7rem;
    color: var(--c-fg-subtle);
  }

  /* metadata */
  .meta {
    display: grid;
    gap: 0.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
  }
  @media (min-width: 48rem) {
    .meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .meta div {
    display: flex;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .meta div {
      display: grid;
      gap: 0.2rem;
    }
  }
  dt {
    color: var(--c-fg-subtle);
    min-width: 4.5rem;
  }
  dt::after {
    content: ':';
  }
  dd {
    color: var(--c-fg-muted);
  }
</style>
