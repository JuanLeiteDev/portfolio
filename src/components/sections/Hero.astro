---
/**
 * Hero — identity, value proposition and the two primary paths
 * (projects / contact) in the first screen on every viewport.
 *
 * Desktop: monumental name + statement on the left, portrait on the right.
 * Mobile: name stacks over two lines, CTAs stay above the fold, the portrait
 * becomes a square frame centred on the face below them.
 * Portrait effect: the photo "develops" once with a scan line (CSS); on
 * hover it tilts, gains colour and a glare follows the cursor (portrait-fx.ts).
 * Flip card: a click (or Enter/Space) turns the photo over to a short
 * "about me"; a hint under the photo says so (main.ts toggles .is-flipped).
 */
import { Image, Picture } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import Section from '@/components/ui/Section.astro';
import { hero } from '@/data/home';
import { profile } from '@/data/profile';
import { sectionHref, t, type Lang } from '@/i18n';
import photo from '@/assets/juan-leite.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Section lang={lang} section="about" class="hero" aliases={lang === 'pt' ? ['hero'] : []}>
  <div class="frame grid-hero">
    <div class="copy">
      <p class="eyebrow mono">
        <span class="dot" aria-hidden="true"></span>
        {t(hero.eyebrow, lang)}
      </p>

      <h1 class="name">
        <span class="sr-only">{profile.name}</span>
        <span class="name-vis" aria-hidden="true">
          <span class="line" data-decode>Juan</span>{' '}
          <span class="line"><span data-decode>Leite</span><span class="cursor"></span></span>
        </span>
      </h1>

      <p class="statement">{t(hero.statement, lang)}</p>
      <ul class="kw mono" role="list">
        {hero.keywords.map((k) => <li>{t(k, lang)}</li>)}
      </ul>

      <div class="ctas">
        <a class="btn btn-primary" href={sectionHref('projects', lang)}>
          {t(hero.ctaPrimary, lang)}
          <span class="arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn" href={sectionHref('contact', lang)}>
          {t(hero.ctaSecondary, lang)}
          <ArrowUpRight class="arrow" size={18} stroke-width={1.6} aria-hidden="true" />
        </a>
      </div>
    </div>

    <figure class="portrait-wrap">
      <div class="flip" data-portrait-fx data-flip>
        <div class="flip-in">
          <div class="face portrait">
            <Picture
              src={photo}
              alt={t(hero.photoAlt, lang)}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 60vw, 100vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="photo"
            />
            <span class="scan" aria-hidden="true"></span>
            <span class="glare" aria-hidden="true"></span>
            <span class="corner tl" aria-hidden="true"></span>
            <span class="corner br" aria-hidden="true"></span>
          </div>
          <div class="face back" id={`about-${lang}`}>
            <Image src={photo} alt="" width={360} format="webp" loading="lazy" decoding="async" class="back-photo" />
            <h2 class="back-title">{t(hero.about.title, lang)}</h2>
            <p class="back-text">{t(hero.about.text, lang)}</p>
            <p class="back-foot mono">
              <span>{t(hero.about.place, lang)}</span>
              <span>{profile.name}</span>
            </p>
          </div>
        </div>
        <button
          type="button"
          class="flip-btn"
          aria-pressed="false"
          aria-controls={`about-${lang}`}
          data-needs-js
        >
          <span class="sr-only">{t(hero.about.flip, lang)}</span>
        </button>
      </div>
      <p class="flip-hint mono" aria-hidden="true" data-needs-js>
        <span class="flip-ico">↻</span>
        <span class="hint-fine">{t(hero.about.hint, lang)}</span>
        <span class="hint-touch">{t(hero.about.hintTouch, lang)}</span>
      </p>
    </figure>

    <dl class="meta mono">
      {
        hero.meta.map((m) => (
          <div>
            <dt>{t(m.k, lang)}</dt>
            <dd>{t(m.v, lang)}</dd>
          </div>
        ))
      }
      <!-- live local time (Barcelos); filled by main.ts, hidden without JS -->
      <div data-clock-row hidden>
        <dt>{t(hero.clockLabel, lang)}</dt>
        <dd><time class="num" data-clock data-tz="Europe/Lisbon" data-locale={lang === 'pt' ? 'pt-PT' : 'en-GB'}></time></dd>
      </div>
    </dl>
  </div>
</Section>

<style>
  :global(.hero.section) {
    padding-top: clamp(1.5rem, 0.5rem + 4vw, 5rem);
    overflow-x: clip; /* the portrait glow must not create horizontal scroll */
  }
  .grid-hero {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'copy'
      'portrait'
      'meta';
  }
  .copy {
    grid-area: copy;
    min-width: 0;
  }
  .portrait-wrap {
    grid-area: portrait;
    position: relative;
  }
  .portrait-wrap::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -30% -25% -20%;
    background: radial-gradient(closest-side, var(--c-signal-soft), transparent);
    pointer-events: none;
  }
  .grid-hero {
    isolation: isolate;
  }
  .meta {
    grid-area: meta;
  }

  @media (min-width: 64rem) {
    .grid-hero {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.5fr);
      grid-template-areas:
        'copy portrait'
        'meta meta';
      column-gap: clamp(2rem, 4vw, 5rem);
      row-gap: 3.5rem;
      align-items: start;
    }
    .portrait-wrap {
      /* aligns the photo with the cap height of the name */
      margin-top: calc(var(--step--1) * 1.6 + clamp(1.25rem, 3vw, 2.25rem));
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-fg-muted);
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--c-signal);
  }

  .name {
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin-inline-start: -0.04em;
  }
  .name-vis {
    display: block;
  }
  .line {
    display: block;
  }
  @media (min-width: 30rem) {
    .line {
      display: inline;
    }
    .line + .line::before {
      content: ' ';
    }
  }
  @media (min-width: 64rem) {
    .line {
      display: block;
    }
    .line + .line::before {
      content: none;
    }
  }
  .cursor {
    display: inline-block;
    width: 0.09em;
    height: 0.1em;
    margin-inline-start: 0.06em;
    background: var(--c-signal);
    vertical-align: baseline;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) 4 both;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.dc-cell) {
    position: relative;
    display: inline-block;
  }
  :global(.dc-ghost) {
    visibility: hidden;
  }
  :global(.dc-live) {
    position: absolute;
    inset: 0;
    text-align: center;
    color: var(--c-signal);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.82em;
    line-height: 1.25;
  }
  :global(.dc-live.is-set) {
    color: inherit;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .statement {
    max-width: 22ch;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--step-3);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 500;
    text-wrap: balance;
  }
  .kw {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .kw li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-fg-muted);
    font-size: 0.8rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 29.999rem) {
    .ctas .btn {
      flex: 1 1 9rem;
      justify-content: space-between;
    }
  }

  /* portrait: a flip card (after React Bits "Flip Card"). Front: the photo;
     back: about me. The outer box carries the tilt (portrait-fx), the inner
     one the flip, so both faces tilt together. Below 64rem: a square frame
     centred on the face (the photo is 2:3, the face sits between ~20% and
     ~58% of its height). */
  .flip {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 26rem;
    perspective: 1100px;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s var(--ease-out);
  }
  @media (min-width: 64rem) {
    .flip {
      aspect-ratio: 4 / 5;
      max-width: none;
    }
  }
  .flip-in {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* settles with a slight overshoot, like a spring */
    transition: transform 0.95s cubic-bezier(0.34, 1.35, 0.5, 1);
  }
  .flip:global(.is-flipped) .flip-in {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-m);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .portrait {
    background: var(--c-bg-sunken);
    isolation: isolate;
  }
  .portrait :global(.photo),
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 37%;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.7s var(--ease-out), scale 0.7s var(--ease-out);
  }
  @media (min-width: 64rem) {
    .portrait :global(img) {
      object-position: 50% 20%;
    }
  }

  /* colour on hover (fine pointer) */
  @media (hover: hover) and (pointer: fine) {
    .flip:not(:global(.is-flipped)):hover .portrait :global(img) {
      filter: grayscale(0) contrast(1);
      scale: 1.03;
    }
  }

  /* back: the photo, dark and blurred, under the text (same in both themes) */
  .back {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
    padding: clamp(1.1rem, 0.9rem + 1.2vw, 1.75rem);
    border: 1px solid rgb(236 233 225 / 0.14);
    background: #0d0e0c;
    color: #ece9e1;
    isolation: isolate;
    transform: rotateY(180deg);
  }
  .back :global(.back-photo) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) blur(16px) brightness(0.32);
    scale: 1.2;
  }
  .back-title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .back-text {
    align-self: center;
    max-width: 38ch;
    color: #d9d5cb;
    font-size: clamp(0.92rem, 0.88rem + 0.25vw, 1.05rem);
    line-height: 1.55;
  }
  .back-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #a6a398;
  }

  /* the whole card is the toggle (keyboard: Tab, Enter/Space) */
  .flip-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius-m);
    background: transparent;
    cursor: pointer;
  }
  .flip-btn:focus-visible {
    outline-offset: 4px;
  }
  .flip-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
    color: var(--c-fg-subtle);
    font-size: 0.72rem;
  }
  .flip-ico {
    display: inline-block;
    color: var(--c-signal);
    font-size: 0.9rem;
    transition: rotate 0.6s var(--ease-out);
  }
  .portrait-wrap:has(:global(.is-flipped)) .flip-ico {
    rotate: 180deg;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  /* reduced motion: no rotation, the faces cross-fade */
  @media (prefers-reduced-motion: reduce) {
    .flip-in {
      transition: none;
    }
    .flip:global(.is-flipped) .flip-in {
      transform: none;
    }
    .face {
      -webkit-backface-visibility: visible;
      backface-visibility: visible;
    }
    .back {
      transform: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s linear, visibility 0s 0.2s;
    }
    .flip:global(.is-flipped) .back {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.2s linear;
    }
  }

  /* glare that follows the cursor (position set by portrait-fx) */
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 30%),
      rgb(255 255 255 / 0.22),
      transparent 45%
    );
    mix-blend-mode: soft-light;
    transition: opacity 0.4s var(--ease-out);
  }
  .flip:global(.has-fx):not(:global(.is-flipped)):hover .glare {
    opacity: 1;
  }

  /* scan line, hidden unless the develop animation runs */
  .scan {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    opacity: 0;
    pointer-events: none;
    background: var(--c-signal);
    box-shadow: 0 0 18px 4px var(--c-signal-soft);
  }

  /* one-shot "develop": over-exposed and soft → sharp, while a scan line
     crosses the frame. The photo is painted from the first frame (LCP). */
  @media (prefers-reduced-motion: no-preference) {
    .portrait :global(img) {
      animation: develop 1.6s var(--ease-out) 0.15s backwards;
    }
    .scan {
      animation: scan 1.5s var(--ease-out) 0.2s both;
    }
  }
  @keyframes develop {
    from {
      filter: grayscale(1) contrast(1.6) brightness(1.7) blur(6px);
    }
    to {
      filter: grayscale(1) contrast(1.05) brightness(1) blur(0);
    }
  }
  @keyframes scan {
    0% {
      opacity: 0;
      top: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      top: 100%;
    }
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-signal);
    border-style: solid;
    pointer-events: none;
    transition: translate 0.4s var(--ease-out);
  }
  .flip:hover .tl {
    translate: -4px -4px;
  }
  .flip:hover .br {
    translate: 4px 4px;
  }
  .tl {
    top: 10px;
    left: 10px;
    border-width: 1px 0 0 1px;
  }
  .br {
    right: 10px;
    bottom: 10px;
    border-width: 0 1px 1px 0;
  }
  /* metadata */
  .meta [hidden] {
    display: none;
  }
  .meta {
    display: grid;
    gap: 0.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
  }
  @media (min-width: 48rem) {
    .meta {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      gap: 1.5rem;
    }
  }
  .meta div {
    display: flex;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .meta div {
      display: grid;
      gap: 0.2rem;
    }
  }
  dt {
    color: var(--c-fg-subtle);
    min-width: 4.5rem;
  }
  dt::after {
    content: ':';
  }
  dd {
    color: var(--c-fg-muted);
  }
</style>
