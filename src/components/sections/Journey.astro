---
/**
 * Journey — two clearly separate blocks.
 *
 * Experience: the one professional role (Eleven Systems) as a single card:
 * period, role and company on one side, what was done and the stack on the
 * other. Nothing hidden behind intent: it is the most important entry.
 *
 * Education: a timeline on a centre spine (after React Bits Pro "Timeline 1"):
 * oldest first, the entries alternate sides, the year set large on one side
 * and what it was on the other. The spine draws itself as the page scrolls
 * and lights each dot as it passes (timeline.ts); it follows the page's own
 * scroll, nothing scrolls inside it. On phones the spine moves to the left
 * and every entry reads year → title.
 * Without JS or with reduced motion the spine is simply complete.
 */
import Section from '@/components/ui/Section.astro';
import { journey } from '@/data/home';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const expId = lang === 'pt' ? 'experiencia' : 'experience';
const eduId = lang === 'pt' ? 'formacoes' : 'education';
const jobs = journey.experience;
---

<Section lang={lang} section="journey" title={t(journey.title, lang)}>
  <div class="frame">
    <!-- ------------------------------------------------------ experience -->
    <div class="block" id={expId}>
      <div class="blk-head">
        <h3 class="blk-title">{t(journey.experienceLabel, lang)}</h3>
        <span class="ruler" aria-hidden="true"></span>
      </div>
      {
        jobs.map((e) => (
          <article class="job paper" data-reveal aria-labelledby="job-title">
            <div class="job-main">
              <p class="period mono num">
                {t(e.period, lang)}
                {e.current && <span class="badge now mono">{t(journey.currentLabel, lang)}</span>}
              </p>
              <h4 id="job-title" class="job-title">
                {t(e.title, lang)}
              </h4>
              <p class="org">{t(e.org, lang)}</p>
              {e.hint && <p class="job-sum">{t(e.hint, lang)}</p>}
            </div>
            <div class="job-detail">
              {e.points && (
                <ul class="points" role="list">
                  {e.points[lang].map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              {e.tags && (
                <ul class="tags mono" role="list" aria-label={lang === 'pt' ? 'Tecnologias' : 'Technologies'}>
                  {e.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <!-- ------------------------------------------------------- education -->
    <div class="block" id={eduId}>
      <div class="blk-head">
        <h3 class="blk-title">{t(journey.educationLabel, lang)}</h3>
        <span class="ruler" aria-hidden="true"></span>
      </div>
      <div class="edu">
        <div class="tl" data-timeline>
          <span class="tl-track" aria-hidden="true">
            <span class="tl-fill"></span>
          </span>
          <ol class="tl-items" role="list">
            {
              journey.education.map((e, i) => (
                <li
                  class:list={['entry', { flip: i % 2 === 1, upcoming: e.upcoming, current: e.current }]}
                  data-reveal
                  data-tl-item
                  style={`--i:${i}`}
                >
                  <p class="yr num">{t(e.period, lang)}</p>
                  <span class="node" aria-hidden="true" />
                  <div class="what">
                    <h4 class="et">
                      {t(e.title, lang)}
                      {e.upcoming && <span class="badge mono">{t(journey.upcomingLabel, lang)}</span>}
                      {e.current && <span class="badge now mono">{t(journey.currentLabel, lang)}</span>}
                    </h4>
                    <p class="org">{t(e.org, lang)}</p>
                    {e.hint && <p class="desc">{t(e.hint, lang)}</p>}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .block {
    scroll-margin-top: 2rem;
  }
  .block + .block {
    margin-top: clamp(4rem, 3rem + 4vw, 6.5rem);
  }
  /* block heading: a title and a ruler, the language of the section heads */
  .blk-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }
  .blk-title {
    flex: none;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }
  .blk-head .ruler {
    flex: 1;
  }

  .period {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-signal);
  }
  .badge {
    padding: 0 0.4rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-s);
    color: var(--c-fg-muted);
    font-size: 0.68rem;
  }
  .badge.now {
    border-color: var(--c-signal);
    color: var(--c-signal);
  }
  .org {
    color: var(--c-fg-muted);
  }

  /* -------------------------------------------------------- experience */
  .job {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    background-color: var(--c-bg-raised);
  }
  @media (min-width: 56rem) {
    .job {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(2rem, 5vw, 4.5rem);
    }
  }
  .job-main {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .job-title {
    margin-top: 0.2rem;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .job-sum {
    margin-top: 0.6rem;
    max-width: 40ch;
    color: var(--c-fg-muted);
  }
  .job-detail {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .points {
    display: grid;
    gap: 0.6rem;
  }
  .points li {
    padding-inline-start: 1.1rem;
    text-indent: -1.1rem;
  }
  .points li::before {
    content: '→ ';
    color: var(--c-signal);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tags li {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-s);
    color: var(--c-fg-muted);
    font-size: 0.72rem;
  }

  /* --------------------------------------------------------- education */
  .edu {
    display: grid;
    gap: clamp(3.5rem, 2.5rem + 3vw, 5rem);
  }

  /* timeline on a spine: left on phones, centred from 48rem */
  .tl {
    --node: 11px;
    --node-top: 0.55rem; /* aligns the dot with the year */
    --spine: calc(var(--node) / 2); /* x of the spine */
    position: relative;
  }
  .tl-track {
    position: absolute;
    top: var(--node-top);
    bottom: 0;
    left: calc(var(--spine) - 0.5px);
    width: 1px;
    background: var(--c-line-strong);
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: var(--c-signal);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }
  .tl-items {
    display: grid;
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    grid-template-areas:
      'node yr'
      'node what';
    row-gap: 0.5rem;
    padding-bottom: 2.75rem;
  }
  .entry:last-child {
    padding-bottom: 0;
  }
  @media (min-width: 48rem) {
    .tl {
      --spine: 50%;
    }
    .entry {
      grid-template-columns: minmax(0, 1fr) clamp(4rem, 8vw, 7rem) minmax(0, 1fr);
      grid-template-areas: 'yr node what';
      padding-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
    }
    .entry.flip {
      grid-template-areas: 'what node yr';
    }
    .entry .yr {
      text-align: end;
    }
    .entry.flip .yr {
      text-align: start;
    }
    .entry.flip .what {
      text-align: end;
      justify-items: end;
    }
  }
  /* the spine ends at the last dot: hide the track below it */
  .entry:last-child::after {
    content: '';
    position: absolute;
    top: calc(var(--node-top) + var(--node));
    bottom: 0;
    left: calc(var(--spine) - var(--node) / 2);
    width: var(--node);
    background: var(--c-bg);
  }
  .yr {
    grid-area: yr;
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .node {
    position: absolute;
    top: var(--node-top);
    left: calc(var(--spine) - var(--node) / 2);
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--c-fg);
    border-radius: 50%;
    background: var(--c-fg);
    transition:
      background-color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      scale var(--dur-3) var(--ease-out);
  }
  /* reached by the spine (or no JS): lit in signal */
  .entry .node,
  .tl:global(.is-ready) .entry:global(.is-reached) .node {
    background: var(--c-signal);
    border-color: var(--c-signal);
  }
  .tl:global(.is-ready) .entry:not(:global(.is-reached)) .node {
    background: var(--c-bg);
    border-color: var(--c-line-strong);
    scale: 0.8;
  }
  .upcoming .node,
  .tl:global(.is-ready) .entry.upcoming:global(.is-reached) .node {
    background: var(--c-bg);
    border-style: dashed;
  }
  /* now: a ring pulses around the dot */
  @media (prefers-reduced-motion: no-preference) {
    .current .node::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 50%;
      border: 1px solid var(--c-signal);
      animation: ring 2.4s var(--ease-out) infinite;
    }
  }
  @keyframes ring {
    from {
      opacity: 0.8;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }
  .what {
    grid-area: what;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  @media (min-width: 48rem) {
    .what {
      padding-top: 0.2rem;
    }
  }
  .et {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .entry.flip .et {
    justify-content: flex-end;
  }
  @media (max-width: 47.999rem) {
    .entry.flip .et {
      justify-content: flex-start;
    }
  }
  .et .badge {
    letter-spacing: 0;
  }
  .desc {
    max-width: 38ch;
    color: var(--c-fg-subtle);
    font-size: var(--step--1);
    line-height: 1.55;
  }
</style>
