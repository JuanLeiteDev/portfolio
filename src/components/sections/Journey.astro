---
/**
 * Journey — a compact dated log: year · title · organisation.
 * Desktop: experience and education share the same grid rows (subgrid), so
 * entries line up side by side; extra courses and languages sit in their own
 * row below. One-line details are revealed on intent.
 */
import Section from '@/components/ui/Section.astro';
import Hint from '@/components/ui/Hint.astro';
import IntentTitle from '@/components/ui/IntentTitle.astro';
import { journey, type JourneyEntry } from '@/data/home';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const upcoming = lang === 'pt' ? 'próximo' : 'next';
const cols: { key: string; id: string; label: string; entries: JourneyEntry[] }[] = [
  { key: 'exp', id: lang === 'pt' ? 'experiencia' : 'experience', label: t(journey.experienceLabel, lang), entries: journey.experience },
  { key: 'edu', id: lang === 'pt' ? 'formacoes' : 'education', label: t(journey.educationLabel, lang), entries: journey.education },
];
const rows = Math.max(...cols.map((c) => c.entries.length));
---

<Section lang={lang} section="journey" title={t(journey.title, lang)}>
  <div class="frame">
    <div class="cols" style={`--rows: ${rows}`}>
      {
        cols.map((col) => (
          <div class="col" id={col.id} style={`--span: ${rows + 1}`}>
            <h3 class="col-label mono">{col.label}</h3>
            <ol class="log" role="list" style={`--span: ${rows}`}>
              {col.entries.map((e, i) => {
                const hid = `${col.key}-${i}`;
                return (
                  <li class:list={['entry', { upcoming: e.upcoming }]} data-intent data-reveal>
                    <span class="period mono num">{t(e.period, lang)}</span>
                    <div class="what">
                      <IntentTitle level={4} controls={hid} class="et">
                        {t(e.title, lang)}
                      </IntentTitle>
                      <p class="org">
                        {t(e.org, lang)}
                        {e.upcoming && <span class="badge mono">{upcoming}</span>}
                      </p>
                      {e.points && (
                        <ul class="points" role="list">
                          {e.points[lang].map((pt) => <li>{pt}</li>)}
                        </ul>
                      )}
                      {e.hint && <Hint text={t(e.hint, lang)} id={hid} />}
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </div>

    <div class="extras">
      <div class="extra">
        <h3 class="col-label mono">{t(journey.courses.label, lang)}</h3>
        <ul class="list" role="list">
          {
            journey.courses.items.map((c) => (
              <li>
                <span>{typeof c.name === 'string' ? c.name : t(c.name, lang)}</span>
                <span class="cm mono num">
                  {c.by} · {c.hours} h · {c.year}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="extra">
        <h3 class="col-label mono">{t(journey.languages.label, lang)}</h3>
        <ul class="list" role="list">
          {
            journey.languages.items.map((l) => (
              <li>
                <span>{t(l.name, lang)}</span>
                <span class="cm">{t(l.level, lang)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  .cols,
  .extras {
    display: grid;
    gap: 3rem;
  }
  .extras {
    margin-top: 3rem;
  }
  @media (min-width: 64rem) {
    .cols,
    .extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
    }
    /* one shared row per entry: label row + N entry rows */
    .cols {
      grid-template-rows: auto repeat(var(--rows), auto);
      row-gap: 0;
    }
    .col {
      display: grid;
      grid-row: span var(--span);
      grid-template-rows: subgrid;
    }
    .log {
      display: grid;
      grid-row: span var(--span);
      grid-template-rows: subgrid;
    }
  }
  .col {
    min-width: 0;
    scroll-margin-top: 2rem;
  }
  .col-label {
    color: var(--c-fg-subtle);
    font-size: var(--step--1);
    font-weight: 400;
    text-transform: lowercase;
    margin-bottom: 0.9rem;
  }
  .log {
    border-top: 1px solid var(--c-line-strong);
  }
  .entry {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--c-line);
    cursor: pointer;
  }
  .period {
    color: var(--c-signal);
    padding-top: 0.3rem;
  }
  .what {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }
  .what :global(.et) {
    font-size: var(--step-1);
    line-height: 1.25;
    transition: color var(--dur-1) linear;
  }
  .entry:is(:hover, :focus-within, .is-open) :global(.et) {
    color: var(--c-signal);
  }
  .org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-fg-muted);
  }
  .badge {
    padding: 0 0.4rem;
    border: 1px solid var(--c-signal);
    border-radius: var(--radius-s);
    color: var(--c-signal);
    font-size: 0.68rem;
  }
  .upcoming :global(.et) {
    color: var(--c-fg-muted);
  }
  .points {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.6rem;
    color: var(--c-fg-muted);
    font-size: var(--step--1);
  }
  .points li {
    padding-inline-start: 1rem;
    text-indent: -1rem;
  }
  .points li::before {
    content: '→ ';
    color: var(--c-signal);
  }

  .list {
    border-top: 1px solid var(--c-line-strong);
  }
  .list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--c-line);
  }
  .cm {
    color: var(--c-fg-subtle);
  }
</style>
