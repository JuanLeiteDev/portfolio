---
/**
 * Journey — education and experience in one timeline, no sub-headings.
 * Every entry is the same size (period, title, place), so the section stays
 * light; the details live in the CV and the projects.
 *
 * A timeline on a centre spine (after React Bits Pro "Timeline 1"):
 * oldest first (by the start year of each period), the entries alternate sides, the year set large on one side
 * and what it was on the other. The spine draws itself as the page scrolls
 * and lights each dot as it passes (timeline.ts); it follows the page's own
 * scroll, nothing scrolls inside it. On phones the spine moves to the left
 * and every entry reads year → title.
 * Without JS or with reduced motion the spine is simply complete.
 */
import Section from '@/components/ui/Section.astro';
import { journey, type JourneyEntry } from '@/data/home';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const startYear = (e: JourneyEntry) => Number(/\d{4}/.exec(e.period.pt)?.[0] ?? 0);
// same start year: the job first (stable sort keeps this order on ties)
const entries = [...journey.experience, ...journey.education].sort((a, b) => startYear(a) - startYear(b));
---

<Section lang={lang} section="journey" title={t(journey.title, lang)}>
  <div class="frame">
    <div class="tl" data-timeline>
      <span class="tl-track" aria-hidden="true">
        <span class="tl-fill"></span>
      </span>
      <ol class="tl-items" role="list">
        {
          entries.map((e, i) => (
            <li
              class:list={['entry', { flip: i % 2 === 1, upcoming: 'upcoming' in e && e.upcoming, current: 'current' in e && e.current }]}
              data-reveal
              data-tl-item
              style={`--i:${i}`}
            >
              <p class="yr num">{t(e.period, lang)}</p>
              <span class="node" aria-hidden="true" />
              <div class="what">
                <h3 class="et">{t(e.title, lang)}</h3>
                <p class="org">{t(e.org, lang)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>

<style>
  .org {
    color: var(--c-fg-muted);
  }

  /* timeline on a spine: left on phones, centred from 48rem */
  .tl {
    --node: 11px;
    --node-top: 0.55rem; /* aligns the dot with the year */
    --spine: calc(var(--node) / 2); /* x of the spine */
    position: relative;
  }
  .tl-track {
    position: absolute;
    top: var(--node-top);
    bottom: 0;
    left: calc(var(--spine) - 0.5px);
    width: 1px;
    background: var(--c-line-strong);
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: var(--c-signal);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }
  .tl-items {
    display: grid;
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    grid-template-areas:
      'node yr'
      'node what';
    row-gap: 0.5rem;
    padding-bottom: 4rem;
  }
  .entry:last-child {
    padding-bottom: 0;
  }
  @media (min-width: 48rem) {
    .tl {
      --spine: 50%;
    }
    .entry {
      grid-template-columns: minmax(0, 1fr) clamp(4rem, 8vw, 7rem) minmax(0, 1fr);
      grid-template-areas: 'yr node what';
      padding-bottom: clamp(4.5rem, 3rem + 4vw, 6.5rem);
    }
    .entry.flip {
      grid-template-areas: 'what node yr';
    }
    .entry .yr {
      text-align: end;
    }
    .entry.flip .yr {
      text-align: start;
    }
    .entry.flip .what {
      text-align: end;
      justify-items: end;
    }
  }
  /* the spine ends at the last dot: hide the track below it */
  .entry:last-child::after {
    content: '';
    position: absolute;
    top: calc(var(--node-top) + var(--node));
    bottom: 0;
    left: calc(var(--spine) - var(--node) / 2);
    width: var(--node);
    background: var(--c-bg);
  }
  .yr {
    grid-area: yr;
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .node {
    position: absolute;
    top: var(--node-top);
    left: calc(var(--spine) - var(--node) / 2);
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--c-fg);
    border-radius: 50%;
    background: var(--c-fg);
    transition:
      background-color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      scale var(--dur-3) var(--ease-out);
  }
  /* reached by the spine (or no JS): lit in signal */
  .entry .node,
  .tl:global(.is-ready) .entry:global(.is-reached) .node {
    background: var(--c-signal);
    border-color: var(--c-signal);
  }
  .tl:global(.is-ready) .entry:not(:global(.is-reached)) .node {
    background: var(--c-bg);
    border-color: var(--c-line-strong);
    scale: 0.8;
  }
  .upcoming .node,
  .tl:global(.is-ready) .entry.upcoming:global(.is-reached) .node {
    background: var(--c-bg);
    border-style: dashed;
  }
  /* now: a ring pulses around the dot */
  @media (prefers-reduced-motion: no-preference) {
    .current .node::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 50%;
      border: 1px solid var(--c-signal);
      animation: ring 2.4s var(--ease-out) infinite;
    }
  }
  @keyframes ring {
    from {
      opacity: 0.8;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }
  .what {
    grid-area: what;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  @media (min-width: 48rem) {
    .what {
      padding-top: 0.2rem;
    }
  }
  .et {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
</style>
