---
/**
 * Contact — the four mandatory actions (WhatsApp, LinkedIn, GitHub, CV) as
 * semantic links laid out as a list of rows, plus email as a complement.
 * Mobile: one column of rows (≥ 72px targets). From 48rem: two columns.
 * Works without JS; only "copy email" is an enhancement.
 */
import { ArrowUpRight, Download, Copy } from '@lucide/astro';
import Section from '@/components/ui/Section.astro';
import { contact } from '@/data/home';
import { contactActions, profile } from '@/data/profile';
import { ui, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Section lang={lang} section="contact" title={t(contact.title, lang)} intro={t(contact.body, lang)} headClass="contact-head">
  <div class="frame">
    <ul class="keys" role="list">
      {
        contactActions.map((a, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a
              class="key spot"
              data-contact={a.key}
              href={a.href}
              {...(a.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(a.download ? { download: a.download, type: 'application/pdf' } : {})}
            >
              <span class="glyph mono" aria-hidden="true">
                {a.glyph}
              </span>
              <span class="txt">
                <span class="kl">{t(a.label, lang)}</span>
                <span class="kd mono">{t(a.detail, lang)}</span>
              </span>
              {a.download ? (
                <Download class="ico" size={20} stroke-width={1.6} aria-hidden="true" />
              ) : (
                <ArrowUpRight class="ico" size={20} stroke-width={1.6} aria-hidden="true" />
              )}
              {a.external && <span class="sr-only"> {t(ui.newTab, lang)}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="email">
      <span class="label">{t(contact.emailLabel, lang)}</span>
      <a class="addr link" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button
        type="button"
        class="copy"
        data-copy={profile.email}
        data-ok={t(ui.copied, lang)}
        data-fail={t(ui.copyFailed, lang)}
        data-needs-js
      >
        <Copy size={16} stroke-width={1.6} aria-hidden="true" />
        <span>{t(ui.copyEmail, lang)}</span>
      </button>
      <span class="status mono" role="status" data-copy-status></span>
    </div>
  </div>
</Section>

<style>
  :global(.contact-head .title) {
    font-size: var(--step-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  /* contact actions as a list of rows (same language as the project index) */
  .keys {
    display: grid;
    border-top: 1px solid var(--c-line-strong);
  }
  @media (min-width: 48rem) {
    .keys {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  .keys li {
    border-bottom: 1px solid var(--c-line);
  }
  .key {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.5rem;
    padding: 1rem 0.25rem;
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .key::before {
    content: '';
    position: absolute;
    inset-block: -1px;
    inset-inline-start: 0;
    width: 2px;
    background: var(--c-signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .glyph {
    padding-inline-start: 0.5rem;
    color: var(--c-fg-subtle);
    font-size: 0.8rem;
    transition: color var(--dur-1) linear;
  }
  .txt {
    display: grid;
    gap: 0.15rem;
  }
  .kl {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: color var(--dur-1) linear;
  }
  .kd {
    color: var(--c-fg-subtle);
    font-size: 0.72rem;
  }
  .key :global(.ico) {
    color: var(--c-fg-subtle);
    transition: transform var(--dur-2) var(--ease-out), color var(--dur-1) linear;
  }
  .key:is(:hover, :focus-visible)::before {
    transform: scaleY(1);
  }
  .key:is(:hover, :focus-visible) .kl,
  .key:is(:hover, :focus-visible) .glyph,
  .key:is(:hover, :focus-visible) :global(.ico) {
    color: var(--c-signal);
  }
  .key:is(:hover, :focus-visible) :global(.ico) {
    transform: translate(3px, -3px);
  }
  .key[data-contact='cv']:is(:hover, :focus-visible) :global(.ico) {
    transform: translateY(3px);
  }
  .key:focus-visible {
    outline-offset: -2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .key:hover {
      background: var(--c-bg-raised);
    }
  }


  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
  }
  .addr {
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    color: var(--c-fg-muted);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color var(--dur-1) linear, border-color var(--dur-1) linear;
  }
  .copy:hover {
    color: var(--c-fg);
    border-color: var(--c-line-strong);
  }
  .copy[data-state='done'] {
    color: var(--c-signal);
    border-color: var(--c-signal);
  }
  .status {
    color: var(--c-signal);
    min-width: 1px;
  }
</style>
