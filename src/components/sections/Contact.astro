---
/**
 * Contact — the four mandatory actions (WhatsApp, LinkedIn, GitHub, CV) as
 * semantic links laid out as a list of rows, plus email as a complement.
 * Mobile: one column of rows (≥ 72px targets). From 48rem: two columns.
 * Works without JS; "copy email" and the Stack frame are enhancements.
 *
 * Stack: a minimalist frame where the technologies, with their original
 * logos, fall and pile up on the floor (stack-physics.ts). Press and drag
 * moves an object and can throw the pile around; hovering does nothing.
 * The objects are decorative (aria-hidden); assistive tech reads the list
 * of names. Reduced motion: the objects rest in rows, nothing moves.
 */
import { ArrowUpRight, Download, Copy, Database } from '@lucide/astro';
import Section from '@/components/ui/Section.astro';
import { contact } from '@/data/home';
import { techLogos } from '@/data/tech-icons';
import { contactActions, profile } from '@/data/profile';
import { ui, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { stack } = contact;
---

<Section lang={lang} section="contact" title={t(contact.title, lang)} intro={t(contact.body, lang)} headClass="contact-head">
  <div class="frame">
    <ul class="keys" role="list">
      {
        contactActions.map((a, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a
              class="key spot"
              data-contact={a.key}
              href={a.href}
              {...(a.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(a.download ? { download: a.download, type: 'application/pdf' } : {})}
            >
              <span class="glyph mono" aria-hidden="true">
                {a.glyph}
              </span>
              <span class="txt">
                <span class="kl">{t(a.label, lang)}</span>
                <span class="kd mono">{t(a.detail, lang)}</span>
              </span>
              {a.download ? (
                <Download class="ico" size={20} stroke-width={1.6} aria-hidden="true" />
              ) : (
                <ArrowUpRight class="ico" size={20} stroke-width={1.6} aria-hidden="true" />
              )}
              {a.external && <span class="sr-only"> {t(ui.newTab, lang)}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="email">
      <span class="label">{t(contact.emailLabel, lang)}</span>
      <a class="addr link" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button
        type="button"
        class="copy"
        data-copy={profile.email}
        data-ok={t(ui.copied, lang)}
        data-fail={t(ui.copyFailed, lang)}
        data-needs-js
      >
        <Copy size={16} stroke-width={1.6} aria-hidden="true" />
        <span>{t(ui.copyEmail, lang)}</span>
      </button>
      <span class="status mono" role="status" data-copy-status></span>
    </div>

    <div class="stackbox" data-stackbox data-needs-js data-reveal>
      <p class="sb-label mono" aria-hidden="true">{t(stack.title, lang)}</p>
      <p class="sr-only">{t(stack.title, lang)}: {stack.items.map((o) => o.name).join(', ')}.</p>
      <div class="sb-world paper" data-physics aria-hidden="true">
        {
          stack.items.map((o) => (
            <span class:list={['obj', `ink-${o.ink}`]} style={`--bg:${o.color}`}>
              <span class="sb-badge">
                {o.icon ? <span class="sb-ico" set:html={techLogos[o.icon]} /> : <Database class="sb-db" size={18} stroke-width={2} />}
              </span>
              <span class="sb-name">{o.name}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</Section>

<style>
  :global(.contact-head .title) {
    font-size: var(--step-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  /* contact actions as a list of rows (same language as the project index) */
  .keys {
    display: grid;
    border-top: 1px solid var(--c-line-strong);
  }
  @media (min-width: 48rem) {
    .keys {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  .keys li {
    border-bottom: 1px solid var(--c-line);
  }
  .key {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.5rem;
    padding: 1rem 0.25rem;
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .key::before {
    content: '';
    position: absolute;
    inset-block: -1px;
    inset-inline-start: 0;
    width: 2px;
    background: var(--c-signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .glyph {
    padding-inline-start: 0.5rem;
    color: var(--c-fg-subtle);
    font-size: 0.8rem;
    transition: color var(--dur-1) linear;
  }
  .txt {
    display: grid;
    gap: 0.15rem;
  }
  .kl {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: color var(--dur-1) linear;
  }
  .kd {
    color: var(--c-fg-subtle);
    font-size: 0.72rem;
  }
  .key :global(.ico) {
    color: var(--c-fg-subtle);
    transition: transform var(--dur-2) var(--ease-out), color var(--dur-1) linear;
  }
  .key:is(:hover, :focus-visible)::before {
    transform: scaleY(1);
  }
  .key:is(:hover, :focus-visible) .kl,
  .key:is(:hover, :focus-visible) .glyph,
  .key:is(:hover, :focus-visible) :global(.ico) {
    color: var(--c-signal);
  }
  .key:is(:hover, :focus-visible) :global(.ico) {
    transform: translate(3px, -3px);
  }
  .key[data-contact='cv']:is(:hover, :focus-visible) :global(.ico) {
    transform: translateY(3px);
  }
  .key:focus-visible {
    outline-offset: -2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .key:hover {
      background: var(--c-bg-raised);
    }
  }


  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
  }
  .addr {
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    color: var(--c-fg-muted);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color var(--dur-1) linear, border-color var(--dur-1) linear;
  }
  .copy:hover {
    color: var(--c-fg);
    border-color: var(--c-line-strong);
  }
  .copy[data-state='done'] {
    color: var(--c-signal);
    border-color: var(--c-signal);
  }
  .status {
    color: var(--c-signal);
    min-width: 1px;
  }

  /* --------------------------------------------------------------- Stack */
  .stackbox {
    --o: clamp(2.2rem, 1.95rem + 0.7vw, 2.75rem); /* pill height */
    position: relative;
    max-width: 46rem; /* a shorter rectangle, centred */
    margin: clamp(2.5rem, 2rem + 2vw, 4rem) auto 0;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .sb-label {
    position: absolute;
    z-index: 1;
    top: 0.9rem;
    left: 1.1rem;
    color: var(--c-fg-subtle);
    pointer-events: none;
  }
  /* the world: the frame itself; its bottom edge is the floor */
  .sb-world {
    position: relative;
    height: clamp(13rem, 10rem + 5vw, 16rem);
    overflow: hidden;
    background-color: var(--c-bg);
  }
  /* narrow frames: the 15 pills need roughly twice their own area to pile
     up loosely (a random heap fills about half the space), so the pills
     shrink a little and the frame grows taller; otherwise the heap reaches
     the ceiling and new pills spawn inside it */
  @media (max-width: 40rem) {
    .stackbox {
      --o: 2.05rem;
    }
    .sb-world {
      height: 19rem;
    }
  }
  @media (max-width: 24rem) {
    .stackbox {
      --o: 1.95rem;
    }
    .sb-world {
      height: 21rem;
    }
  }
  /* objects: brand-coloured pills, the original logo on a white badge */
  .obj {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--o) * 0.26);
    height: var(--o);
    padding-inline: calc(var(--o) * 0.17) calc(var(--o) * 0.38);
    border-radius: calc(var(--o) * 0.3);
    background: var(--bg);
    color: #fff;
    font-size: calc(var(--o) * 0.4);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 10px 22px -12px rgb(0 0 0 / 0.55);
    opacity: 0;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: none; /* press and drag moves the object, not the page */
    transform-origin: 50% 50%;
    will-change: transform;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .obj.ink-dark {
    color: #141411;
  }
  .obj:global(.is-on) {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .obj {
      cursor: grab;
    }
    .obj:global(.is-grab) {
      cursor: grabbing;
    }
  }
  .sb-badge {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--o) * 0.68);
    height: calc(var(--o) * 0.68);
    border-radius: calc(var(--o) * 0.2);
    background: #fff;
    color: #334155;
    pointer-events: none;
  }
  .sb-ico {
    display: block;
    width: 70%;
    height: 70%;
  }
  .sb-ico :global(svg) {
    width: 100%;
    height: 100%;
  }
  .sb-badge :global(.sb-db) {
    width: 62%;
    height: 62%;
  }
  .sb-name {
    pointer-events: none;
  }

  /* reduced motion (no simulation): the objects rest in rows on the floor */
  .sb-world:global(.is-static) {
    display: flex;
    flex-wrap: wrap-reverse;
    align-content: flex-start;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
  }
  .sb-world:global(.is-static) .obj {
    position: relative;
    opacity: 1;
    touch-action: auto;
    cursor: default;
  }
</style>
