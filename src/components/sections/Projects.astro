---
/**
 * Projects: every project, the log analyser included, in one accordion
 * gallery (after React Bits "Accordion Gallery", rebuilt in CSS + a few
 * lines of TS, no GSAP): one panel is open at a time. The log analyser opens
 * first. Its figures (projectsSection.featured.stats) and the Odometer
 * component are kept, unused for now, to be reused elsewhere.
 * Desktop: a row of panels; hover or keyboard focus opens one, the others
 * narrow, tilt slightly and go grey. Below 48rem: a vertical stack, a tap
 * on a closed panel opens it, a tap on the open one follows its link.
 * Each panel is one link (stretched over the panel); the GitHub link sits
 * above it, so links are never nested.
 * Previous list layout: Projects.list.astro (backup).
 */
import Section from '@/components/ui/Section.astro';
import { Image } from 'astro:assets';
import { projectsSection } from '@/data/home';
import { projects, kindLabel } from '@/data/projects';
import { routes, ui, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = projectsSection.featured;
// the featured project (log analyser) opens first
const all = projects
  .map((p, i) => ({ p, n: i + 1 }))
  .sort((a, b) => Number(b.p.slug === f.slug) - Number(a.p.slug === f.slug));
const code = projectsSection.code;
---

<Section lang={lang} section="projects" title={t(projectsSection.title, lang)}>
  <div class="frame">
    <ol class="acc" role="list" data-acc data-reveal>
      {
        all.map(({ p, n }, i) => (
          <li class="panel" data-acc-panel data-active={i === 0 ? '' : undefined} data-side={i === 0 ? undefined : 'after'}>
            {p.media?.[0] && (
              <Image
                src={p.media[0].src}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 55vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="media"
              />
            )}
            <span class="shade" aria-hidden="true" />
            <a class="hit" data-acc-link href={routes.project(p.slug)[lang]}>
              <span class="sr-only">{t(p.name, lang)}</span>
            </a>
            <span class="n mono num" aria-hidden="true">
              {String(n).padStart(2, '0')}
            </span>
            <span class="closed-name" aria-hidden="true">
              {t(p.name, lang)}
            </span>
            <div class="body">
              <p class="meta mono">
                <span class="kind">{t(kindLabel[p.kind], lang)}</span>
                {p.ongoing && (
                  <span class="ongoing">
                    <span class="pulse" aria-hidden="true" />
                    {t(code.ongoing, lang)}
                  </span>
                )}
                <span class="year num">{p.year}</span>
              </p>
              <h3 class="name" id={`acc-${p.slug}`}>
                {t(p.name, lang)}
              </h3>
              <p class="tagline">{t(p.tagline, lang)}</p>
              <p class="stack mono">{p.stack.slice(0, 4).join(' · ')}</p>
              <p class="foot mono">
                <span class="see" aria-hidden="true">
                  {t(ui.viewProject, lang)} →
                </span>
                <span class="code-line">
                  {t(code.label, lang)}:{' '}
                  {p.links[0] ? (
                    <a class="link" href={p.links[0].href} target="_blank" rel="noopener noreferrer">
                      {t(code.public, lang)}
                      <span aria-hidden="true"> ↗</span>
                      <span class="sr-only">
                        , {t(p.name, lang)} {t(ui.newTab, lang)}
                      </span>
                    </a>
                  ) : (
                    t(code.private, lang)
                  )}
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  /* one open panel per gallery: mouse hover or keyboard focus opens it; a
     tap/click on a closed panel opens it instead of following the link */
  document.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
    const panels = Array.from(acc.querySelectorAll<HTMLElement>('[data-acc-panel]'));
    const open = (k: number) =>
      panels.forEach((p, i) => {
        p.toggleAttribute('data-active', i === k);
        if (i === k) delete p.dataset.side;
        else p.dataset.side = i < k ? 'before' : 'after';
      });
    panels.forEach((p, i) => {
      p.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') open(i);
      });
      p.addEventListener('focusin', (e) => {
        if ((e.target as Element).matches(':focus-visible')) open(i);
      });
      p.querySelector('[data-acc-link]')?.addEventListener('click', (e) => {
        if (!p.hasAttribute('data-active')) {
          e.preventDefault();
          open(i);
        }
      });
    });
  });
</script>

<style>
  .code-line {
    font-size: 0.75rem;
  }
  /* ------------------------------------------------ accordion gallery
     Panels always sit on a dark image, so their colours are fixed (same in
     both themes, like the back of the hero portrait). */
  .acc {
    --acc-ease: cubic-bezier(0.215, 0.61, 0.355, 1); /* ≈ GSAP power3.out */
    --acc-dur: 0.6s;
    --acc-tilt: 6deg;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    height: 5.5rem;
    border: 1px solid rgb(236 233 225 / 0.12);
    border-radius: var(--radius-l);
    background: #0d0e0c;
    color: #ece9e1;
    isolation: isolate;
    cursor: pointer;
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.8);
    transition:
      height var(--acc-dur) var(--acc-ease),
      flex-grow var(--acc-dur) var(--acc-ease),
      transform var(--acc-dur) var(--acc-ease),
      border-color var(--dur-2) var(--ease-out);
  }
  .panel[data-active] {
    height: 25rem;
    border-color: rgb(236 233 225 / 0.22);
  }
  .panel:has(:focus-visible) {
    outline: 2px solid var(--c-signal);
    outline-offset: 3px;
  }

  /* screenshot: grey and dimmed when closed, in colour when open */
  .panel :global(.media) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    filter: grayscale(1) brightness(0.32);
    scale: 1.06;
    transition:
      filter var(--acc-dur) var(--acc-ease),
      scale var(--acc-dur) var(--acc-ease);
  }
  .panel[data-active] :global(.media) {
    filter: none;
    scale: 1;
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(13 14 12 / 0.55) 0%,
      rgb(13 14 12 / 0.1) 22%,
      rgb(13 14 12 / 0.75) 32%,
      rgb(13 14 12 / 0.95) 48%,
      rgb(13 14 12 / 0.97) 100%
    );
    pointer-events: none;
  }

  /* closed: number + name */
  .n {
    position: absolute;
    top: 0.85rem;
    left: 0.9rem;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-s, 4px);
    background: rgb(13 14 12 / 0.85);
    color: var(--c-signal);
    font-size: 0.75rem;
  }
  .closed-name {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1rem;
    overflow: hidden;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition:
      opacity calc(var(--acc-dur) * 0.6) var(--acc-ease),
      translate calc(var(--acc-dur) * 0.6) var(--acc-ease);
  }
  .panel[data-active] .closed-name {
    opacity: 0;
    translate: -14px 0;
  }

  /* below desktop: closed panels are a slim bar (number + name on one
     line), so the open one gets the room; no tech list in the open one */
  @media (max-width: 63.999rem) {
    .panel {
      height: 2.85rem;
    }
    .panel[data-active] {
      height: 24rem;
    }
    .n,
    .closed-name {
      top: 50%;
      translate: 0 -50%;
      transition:
        top var(--acc-dur) var(--acc-ease),
        translate var(--acc-dur) var(--acc-ease),
        opacity calc(var(--acc-dur) * 0.6) var(--acc-ease);
    }
    .closed-name {
      left: 3.5rem;
      bottom: auto;
      font-size: 1.05rem;
    }
    .panel[data-active] .n {
      top: 0.85rem;
      translate: 0 0;
    }
    .panel[data-active] .closed-name {
      translate: -14px -50%;
    }
    .stack {
      display: none;
    }
  }

  /* open: the details, cascading in */
  /* the project link covers the whole panel (always focusable/clickable);
     the details sit above it but let clicks through, except the GitHub link */
  .hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hit:focus-visible {
    outline: none; /* the panel shows the focus ring */
  }
  .body {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.45rem;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    pointer-events: none;
  }
  .panel[data-active] .body .link {
    pointer-events: auto;
  }
  .body > * {
    opacity: 0;
    translate: -14px 0;
    transition:
      opacity calc(var(--acc-dur) * 0.6) var(--acc-ease),
      translate calc(var(--acc-dur) * 0.6) var(--acc-ease);
  }
  .panel[data-active] .body > * {
    opacity: 1;
    translate: 0 0;
    transition-duration: var(--acc-dur);
  }
  .panel[data-active] .body > :nth-child(1) {
    transition-delay: 0.12s;
  }
  .panel[data-active] .body > :nth-child(2) {
    transition-delay: 0.18s;
  }
  .panel[data-active] .body > :nth-child(3) {
    transition-delay: 0.24s;
  }
  .panel[data-active] .body > :nth-child(4) {
    transition-delay: 0.3s;
  }
  .panel[data-active] .body > :nth-child(5) {
    transition-delay: 0.36s;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: #a6a398;
    font-size: 0.78rem;
  }
  .kind {
    color: var(--c-signal);
  }
  .name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .tagline {
    max-width: 46ch;
    color: #d9d5cb;
  }
  .stack {
    color: #a6a398;
    font-size: 0.78rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(236 233 225 / 0.16);
  }
  .see {
    color: var(--c-signal);
  }
  .foot .code-line {
    color: #a6a398;
  }
  .foot .code-line .link {
    color: #ece9e1;
  }

  /* desktop: a row of panels; the open one takes ~57% of the width, the
     closed ones tilt away from it and show the name vertically */
  @media (min-width: 64rem) {
    .acc {
      flex-direction: row;
      height: clamp(26rem, 20rem + 12vw, 32rem);
      perspective: 1400px;
    }
    .panel,
    .panel[data-active] {
      flex: 1 1 0;
      min-width: 0;
      height: auto;
    }
    .panel[data-active] {
      flex-grow: 9;
    }
    .panel[data-side='before'] {
      transform: rotateY(var(--acc-tilt));
    }
    .panel[data-side='after'] {
      transform: rotateY(calc(var(--acc-tilt) * -1));
    }
    .closed-name {
      left: 50%;
      right: auto;
      bottom: 1.25rem;
      max-height: calc(100% - 4rem);
      writing-mode: vertical-rl;
      rotate: 180deg;
      translate: -50% 0;
      text-overflow: ellipsis;
    }
    .panel[data-active] .closed-name {
      translate: -50% 14px;
    }
    .panel:not([data-active]):hover {
      border-color: rgb(236 233 225 / 0.3);
    }
    .body {
      min-width: 26rem; /* text doesn't reflow while the panel grows */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc {
      --acc-dur: 0s;
    }
    .panel[data-side] {
      transform: none;
    }
    .panel[data-active] .body > * {
      transition-delay: 0s;
    }
  }

  /* live status for projects still in development */
  .ongoing {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-fg-muted);
  }
  .pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-signal);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--c-signal);
      animation: pulse 2s var(--ease-out) infinite;
    }
  }
  @keyframes pulse {
    from {
      opacity: 0.7;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 3;
    }
  }
</style>
